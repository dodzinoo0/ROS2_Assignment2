<?xml version="1.0"?>
<robot name="robotic_arm">

  <!-- ==================== Materials ==================== -->
  <material name="dark_grey">
    <color rgba="0.22 0.24 0.28 1.0"/>
  </material>
  <material name="blue">
    <color rgba="0.12 0.45 0.78 1.0"/>
  </material>
  <material name="orange">
    <color rgba="0.90 0.42 0.10 1.0"/>
  </material>
  <material name="silver">
    <color rgba="0.72 0.75 0.78 1.0"/>
  </material>
  <material name="red">
    <color rgba="0.80 0.16 0.16 1.0"/>
  </material>

  <!-- ==================== World Anchor ==================== -->
  <link name="world"/>

  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ==================== Base Link (8 cm height) ==================== -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry>
        <box size="0.10 0.10 0.08"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry>
        <box size="0.10 0.10 0.08"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <mass value="1.5"/>
      <inertia ixx="0.00205" ixy="0.0" ixz="0.0"
               iyy="0.00205" iyz="0.0"
               izz="0.00250"/>
    </inertial>
  </link>

  <!-- ==================== Joint 1: Base Rotation (Yaw) ==================== -->
  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="L1"/>
    <origin xyz="0 0 0.08" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.5708" upper="1.5708" effort="10.0" velocity="2.0"/>
    <dynamics damping="0.4" friction="0.05"/>
  </joint>

  <!-- ==================== Link L1 (12 cm height) ==================== -->
  <link name="L1">
    <visual>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.12"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.12"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <mass value="0.30"/>
      <inertia ixx="0.00041" ixy="0.0" ixz="0.0"
               iyy="0.00041" iyz="0.0"
               izz="0.00009"/>
    </inertial>
  </link>

  <!-- ==================== Joint 2: Shoulder Pitch ==================== -->
  <joint name="joint2" type="revolute">
    <parent link="L1"/>
    <child link="L2"/>
    <origin xyz="0 0 0.12" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="10.0" velocity="2.0"/>
    <dynamics damping="0.4" friction="0.05"/>
  </joint>

  <!-- ==================== Link L2 (15 cm length) ==================== -->
  <link name="L2">
    <visual>
      <origin xyz="0 0 0.075" rpy="0 0 0"/>
      <geometry>
        <box size="0.030 0.030 0.15"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.075" rpy="0 0 0"/>
      <geometry>
        <box size="0.030 0.030 0.15"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.075" rpy="0 0 0"/>
      <mass value="0.25"/>
      <inertia ixx="0.00049" ixy="0.0" ixz="0.0"
               iyy="0.00049" iyz="0.0"
               izz="0.00004"/>
    </inertial>
  </link>

  <!-- ==================== Joint 3: Elbow Pitch ==================== -->
  <joint name="joint3" type="revolute">
    <parent link="L2"/>
    <child link="L3"/>
    <origin xyz="0 0 0.15" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="8.0" velocity="2.0"/>
    <dynamics damping="0.3" friction="0.05"/>
  </joint>

  <!-- ==================== Link L3 (9 cm length) ==================== -->
  <link name="L3">
    <visual>
      <origin xyz="0 0 0.045" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.025 0.09"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.045" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.025 0.09"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.045" rpy="0 0 0"/>
      <mass value="0.18"/>
      <inertia ixx="0.00013" ixy="0.0" ixz="0.0"
               iyy="0.00013" iyz="0.0"
               izz="0.00002"/>
    </inertial>
  </link>

  <!-- ==================== Joint 4: Wrist / End-Effector Pitch ==================== -->
  <joint name="joint4" type="revolute">
    <parent link="L3"/>
    <child link="end_effector"/>
    <origin xyz="0 0 0.09" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="5.0" velocity="2.0"/>
    <dynamics damping="0.2" friction="0.02"/>
  </joint>

  <!-- ==================== End Effector / Gripper (6 cm length) ==================== -->
  <link name="end_effector">
    <visual>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry>
        <box size="0.020 0.040 0.06"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry>
        <box size="0.020 0.040 0.06"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <mass value="0.10"/>
      <inertia ixx="0.00004" ixy="0.0" ixz="0.0"
               iyy="0.00003" iyz="0.0"
               izz="0.00002"/>
    </inertial>
  </link>

  <!-- ==================== Gazebo (gz sim) Plugins ==================== -->
  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
      <joint_name>joint1</joint_name>
      <joint_name>joint2</joint_name>
      <joint_name>joint3</joint_name>
      <joint_name>joint4</joint_name>
    </plugin>

    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>joint1</joint_name>
      <topic>/arm_gz/joint1/cmd_pos</topic>
      <p_gain>15.0</p_gain>
      <i_gain>0.5</i_gain>
      <d_gain>1.5</d_gain>
      <cmd_max>10.0</cmd_max>
      <cmd_min>-10.0</cmd_min>
    </plugin>

    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>joint2</joint_name>
      <topic>/arm_gz/joint2/cmd_pos</topic>
      <p_gain>20.0</p_gain>
      <i_gain>1.0</i_gain>
      <d_gain>2.0</d_gain>
      <cmd_max>10.0</cmd_max>
      <cmd_min>-10.0</cmd_min>
    </plugin>

    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>joint3</joint_name>
      <topic>/arm_gz/joint3/cmd_pos</topic>
      <p_gain>15.0</p_gain>
      <i_gain>0.8</i_gain>
      <d_gain>1.5</d_gain>
      <cmd_max>8.0</cmd_max>
      <cmd_min>-8.0</cmd_min>
    </plugin>

    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>joint4</joint_name>
      <topic>/arm_gz/joint4/cmd_pos</topic>
      <p_gain>10.0</p_gain>
      <i_gain>0.5</i_gain>
      <d_gain>1.0</d_gain>
      <cmd_max>5.0</cmd_max>
      <cmd_min>-5.0</cmd_min>
    </plugin>
  </gazebo>

</robot>
